    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
